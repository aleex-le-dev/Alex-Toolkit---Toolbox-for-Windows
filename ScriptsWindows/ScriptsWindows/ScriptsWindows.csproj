<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>AlexToolkit</AssemblyName>
    <RootNamespace>ScriptsWindows</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Publication .exe unique autonome : le runtime .NET 10 Desktop est INCLUS dans l'exe.
         Aucune installation ni téléchargement sur le PC cible (fonctionne hors ligne, sur clé USB). -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <!-- Compression du contenu embarqué : ≈ 65 Mo au lieu de ≈ 150 Mo -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- ── Optimisations de performance ───────────────────────────── -->
    <!-- Tiered Compilation : JIT adaptatif (Quick JIT → Full JIT) -->
    <Optimize>true</Optimize>
    <TieredCompilation>true</TieredCompilation>
    <TieredCompilationQuickJit>true</TieredCompilationQuickJit>
    <!-- ReadyToRun : pré-compilation AOT des méthodes fréquentes → démarrage plus rapide -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Pas de symboles de debug en release -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- Seules les ressources françaises sont embarquées (retire les satellites des dépendances, ex. ModernWpfUI) -->
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>

    <!-- ── Métadonnées & Icône ─────────────────────────────────────── -->
    <Version>4.2.62</Version>
    <Company>AleexLeDev</Company>
    <Product>Alex Toolkit</Product>
    <Copyright>© 2026 AleexLeDev</Copyright>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
  </PropertyGroup>


  <ItemGroup>
    <!-- AppMessageBox (boîte de message au thème de l'application) accessible partout -->
    <Using Include="ScriptsWindows.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Scripts du menu contextuel installés dans C:\ProgramData\AlexToolkit (PersonalizationService) -->
    <EmbeddedResource Include="Assets\Scripts\ForceDelete.ps1" LogicalName="ForceDelete.ps1" />
    <EmbeddedResource Include="Assets\Scripts\OpenAdminTerminal.ps1" LogicalName="OpenAdminTerminal.ps1" />
    <EmbeddedResource Include="Assets\Scripts\Migration\Backup-ClientPC.ps1" LogicalName="Backup-ClientPC.ps1" />
    <EmbeddedResource Include="Assets\Scripts\Migration\Restore-ClientPC.ps1" LogicalName="Restore-ClientPC.ps1" />
    <EmbeddedResource Include="Assets\Scripts\Migration\Unlock-ClientDrive.ps1" LogicalName="Unlock-ClientDrive.ps1" />
    <!-- Script « Grand nettoyage » posé sur le Bureau (CleaningService.CreateDesktopCleanupScript) -->
    <EmbeddedResource Include="Assets\Scripts\Nettoyage_Systeme_Et_Disque.ps1" LogicalName="Nettoyage_Systeme_Et_Disque.ps1" />
  </ItemGroup>

  <ItemGroup>
    <!-- UI Fluent Design Windows 11 -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

  <ItemGroup>
    <!-- Date de génération / build automatique injectée à la compilation -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>BuildTimestamp</_Parameter1>
      <_Parameter2>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm"))</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Copie automatique du binaire autonome vers la racine du dépôt lors de la publication -->
  <Target Name="CopyRootExeOnPublish" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)AlexToolkit.exe" DestinationFolder="$(MSBuildThisFileDirectory)..\..\" SkipUnchangedFiles="false" ContinueOnError="true" />
  </Target>

</Project>
