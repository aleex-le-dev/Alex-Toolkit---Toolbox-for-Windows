<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.WifiPasswordsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mots de passe Wi-Fi"
        Width="820" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="680" MinHeight="480"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE701;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Mots de passe Wi-Fi" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Réseaux mémorisés par ce PC et leur clé de sécurité. Les mots de passe restent masqués jusqu'à ce que vous les affichiez."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Recherche + affichage -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="TxtSearch" Style="{StaticResource FieldTextBox}" VerticalContentAlignment="Center" Padding="30,0,8,0" TextChanged="TxtSearch_TextChanged"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource FontIcon}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <Button Grid.Column="1" x:Name="BtnRevealAll" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="BtnRevealAll_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtRevealGlyph" Text="&#xE7B3;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRevealAll" Text="Afficher les mots de passe" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- Liste -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ItemsControl x:Name="ListProfiles">
                    <ItemsControl.Template>
                        <ControlTemplate TargetType="ItemsControl">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                        </ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,11">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="32" Height="32" CornerRadius="16" Background="{Binding IconBg}" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE701;" FontFamily="{StaticResource FontIcon}" FontSize="14" Foreground="{Binding IconFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Ssid}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                            <Border Background="{DynamicResource SuccessBg}" CornerRadius="4" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="{Binding ConnectedVisibility}">
                                                <TextBlock Text="Connecté" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource SuccessText}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding SecurityText}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding DisplayPassword}" FontFamily="{StaticResource FontMono}" FontSize="13"
                                               Foreground="{Binding PasswordFg}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="{Binding EyeGlyph}" Style="{StaticResource IconButton}" ToolTip="Afficher / masquer" Tag="{Binding}"
                                                Click="BtnReveal_Click" IsEnabled="{Binding HasPassword}"/>
                                        <Button Content="&#xE8C8;" Style="{StaticResource IconButton}" ToolTip="Copier le mot de passe" Tag="{Binding}" Margin="4,0,0,0"
                                                Click="BtnCopy_Click" IsEnabled="{Binding HasPassword}"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel x:Name="PanelEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar x:Name="ProgLoad" Width="220" Height="3" IsIndeterminate="True" Margin="0,0,0,12"/>
                    <TextBlock x:Name="TxtEmpty" Text="Lecture des réseaux enregistrés…" Foreground="{DynamicResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pied -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnExport" Style="{StaticResource ActionButton}" Margin="0,0,8,0" IsEnabled="False" Click="BtnExport_Click"
                        ToolTip="Fichier texte avec tous les réseaux et mots de passe (à conserver en lieu sûr)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exporter" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
