<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.SecurityCenterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bilan de sécurité"
        Width="940" Height="800" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="780" MinHeight="600"
        Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Bilan de sécurité" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Chaque protection de Windows vérifiée, expliquée et corrigeable en un clic ; incidents des 7 derniers jours ; mémoire par programme."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
            <Button x:Name="BtnTabDefender" Content="Protection" Tag="TabDefender" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" Click="TabButton_Click"/>
            <Button x:Name="BtnTabEvents" Content="Incidents (7 jours)" Tag="TabEvents" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="TabButton_Click"/>
            <Button x:Name="BtnTabRam" Content="Mémoire" Tag="TabRam" Style="{StaticResource ActionButton}" Click="TabButton_Click"/>
        </StackPanel>

        <!-- Protection -->
        <DockPanel Grid.Row="2" x:Name="PanelDefender">
            <Border DockPanel.Dock="Top" x:Name="PanelScore" CornerRadius="8" Padding="16,12" Margin="0,0,0,12" Background="{DynamicResource BgCard}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Analyse et menaces…" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnQuickScan_Click"/>
                        <Button Content="Tester l'antivirus" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnEicar_Click"/>
                        <Button Style="{StaticResource IconButton}" ToolTip="Refaire le bilan" Click="BtnRefreshDefender_Click">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="14"/>
                        </Button>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtScore" Text="Vérification des protections…" FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtScoreDetail" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelChecks" Margin="8,4"/></ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Incidents -->
        <DockPanel Grid.Row="2" x:Name="PanelEvents" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Historique de fiabilité" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnPerfmon_Click"/>
                    <Button Content="Observateur d'événements" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnEventvwr_Click"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Actualiser" Click="BtnRefreshEvents_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="14"/>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="TxtEventsCount" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
            </DockPanel>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelIncidents" Margin="8,4"/></ScrollViewer>
            </Border>
        </DockPanel>

        <!-- Mémoire -->
        <DockPanel Grid.Row="2" x:Name="PanelRam" Visibility="Collapsed">
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Gestionnaire des tâches" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnTaskMgr_Click"/>
                    <Button Style="{StaticResource IconButton}" ToolTip="Actualiser" Click="BtnRefreshRam_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="14"/>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock x:Name="TxtRamTotalUsage" FontSize="14" FontWeight="SemiBold"/>
                    <Border Height="8" CornerRadius="4" Background="{DynamicResource BgInput}" Margin="0,8,0,0" ClipToBounds="True">
                        <Grid x:Name="BarRam"><Grid.ColumnDefinitions><ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="BarRamFill" CornerRadius="4" Background="{DynamicResource Accent}"/></Grid>
                    </Border>
                </StackPanel>
            </DockPanel>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelMemory" Margin="8,4"/></ScrollViewer>
            </Border>
        </DockPanel>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" Content="Sécurité Windows" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnOpenWindowsSecurity_Click"/>
            <TextBlock x:Name="TxtFeedback" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
