<UserControl x:Class="ScriptsWindows.Views.Controls.DnsSettingsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" x:Name="BtnFlush" Content="Vider le cache DNS" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="BtnFlush_Click"/>
                        <Button DockPanel.Dock="Right" x:Name="BtnTest" Content="Tester les DNS" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="BtnTest_Click"/>
                        <Button DockPanel.Dock="Right" Content="Actualiser" Style="{StaticResource ActionButton}" Click="BtnRefresh_Click"/>
                        <TextBlock Text="CONNEXIONS ACTIVES" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <StackPanel x:Name="PanelAdapters"/>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="CHANGER LES DNS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}"/>
                    <TextBlock x:Name="TxtTarget" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                    <StackPanel x:Name="PanelPresets"/>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" x:Name="BtnCustom" Content="Appliquer" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="BtnCustom_Click"/>
                        <TextBlock Text="Autres serveurs :" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,10,0"/>
                        <TextBox x:Name="TxtCustom" Style="{StaticResource FieldTextBox}" FontFamily="{StaticResource FontMono}"
                                 ToolTip="1 à 4 adresses IPv4 ou IPv6 séparées par des espaces ou des virgules (ex. 94.140.14.14 94.140.15.15)"/>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" x:Name="BtnAuto" Content="Revenir en automatique" Style="{StaticResource ActionButton}" Margin="8,0,0,0" Click="BtnAuto_Click"/>
                        <TextBlock Text="Automatique : DNS fournis par la box ou le routeur (réglage d'origine de Windows)." VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="2,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
