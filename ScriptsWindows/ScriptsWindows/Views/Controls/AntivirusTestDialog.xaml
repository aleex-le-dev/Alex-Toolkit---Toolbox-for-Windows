<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.AntivirusTestDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tester l'antivirus"
        Width="780" Height="740"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="680" MinHeight="560"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xEA18;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Tester l'antivirus" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Vérifie que l'antivirus réagit vraiment, avec des « faux virus » officiels et inoffensifs."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Explication -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondary}">
                    Le test utilise le fichier <Run Text="EICAR" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>, une norme reconnue par tous les antivirus :
                    il ne contient aucun code dangereux, il sert uniquement à déclencher une alerte. Le test de scripts utilise l'échantillon officiel AMSI de Microsoft.
                </TextBlock>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource WarningText}" Margin="0,8,0,0"
                           Text="Votre antivirus va afficher des alertes « menace détectée » et les noter dans son historique : c'est le résultat attendu. Rien n'est à faire, les fichiers de test sont supprimés à la fin."/>
                <TextBlock x:Name="TxtProduct" Text="Recherche de l'antivirus installé…" FontSize="12" FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Verdict -->
        <Border Grid.Row="2" x:Name="PanelVerdict" Visibility="Collapsed" CornerRadius="8" Padding="14,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock x:Name="TxtVerdict" FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtVerdictDetail" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Tests -->
        <Border Grid.Row="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelTests" Margin="8,4"/>
            </ScrollViewer>
        </Border>

        <!-- Pied -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnCancel" Content="Arrêter" Style="{StaticResource DangerActionButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnCancel_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnRun" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" Click="BtnRun_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE768;" FontFamily="{StaticResource FontIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtRun" Text="Lancer le test" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
