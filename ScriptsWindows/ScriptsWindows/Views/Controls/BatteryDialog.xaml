<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.BatteryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Batterie et consommation"
        Width="940" Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="780" MinHeight="620"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource BgCard}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="18,14"/>
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE83F;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Batterie et consommation" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Usure de la batterie et diagnostic Windows de ce qui consomme de l'énergie (pilotes, programmes, réglages)."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Santé de la batterie -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,24,0">
                            <TextBlock Text="SANTÉ DE LA BATTERIE" Style="{StaticResource Label}"/>
                            <TextBlock x:Name="TxtHealth" Text="…" FontSize="40" FontWeight="SemiBold" Margin="0,4,0,0"/>
                            <Border Height="8" CornerRadius="4" Background="{DynamicResource BgInput}" Margin="0,6,0,0">
                                <Border x:Name="HealthBar" Height="8" CornerRadius="4" HorizontalAlignment="Left" Width="0" Background="{DynamicResource Success}"/>
                            </Border>
                            <TextBlock x:Name="TxtVerdict" Text="Lecture du rapport de batterie…" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                        <Grid Grid.Column="1" x:Name="GridDetails">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,12,14">
                                <TextBlock Text="CAPACITÉ D'ORIGINE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtDesign" Text="—" Style="{StaticResource Value}"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,0,0,14">
                                <TextBlock Text="CAPACITÉ ACTUELLE (CHARGE COMPLÈTE)" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtFull" Text="—" Style="{StaticResource Value}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,0,12,14">
                                <TextBlock Text="CYCLES DE CHARGE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtCycles" Text="—" Style="{StaticResource Value}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,0,14">
                                <TextBlock Text="AUTONOMIE ESTIMÉE (UTILISATION ACTIVE)" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtRuntime" Text="—" Style="{StaticResource Value}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.ColumnSpan="2">
                                <TextBlock Text="BATTERIE" Style="{StaticResource Label}"/>
                                <TextBlock x:Name="TxtModel" Text="—" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Évolution de la capacité -->
                <Border x:Name="CardHistory" Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock x:Name="TxtHistoryRange" DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="ÉVOLUTION DE LA CAPACITÉ" Style="{StaticResource Label}"/>
                        </DockPanel>
                        <ItemsControl x:Name="ListHistory" Height="90" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Height="{Binding BarHeight}" VerticalAlignment="Bottom" Margin="1,0" CornerRadius="2,2,0,0"
                                            Background="{DynamicResource Accent}" ToolTip="{Binding Tip}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Diagnostic énergétique -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" x:Name="BtnDiag" Style="{StaticResource PrimaryActionButton}" VerticalAlignment="Center" Click="BtnDiag_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="TxtDiagButton" Text="Lancer le diagnostic (60 s)" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <StackPanel Margin="0,0,16,0">
                                <TextBlock Text="Ce qui consomme de l'énergie" FontWeight="SemiBold" FontSize="14"/>
                                <TextBlock x:Name="TxtDiagInfo" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Text="Windows observe le PC pendant 60 secondes : pilotes qui empêchent la mise en veille, programmes qui sollicitent le processeur, réglages d'alimentation inadaptés. Fermez vos applications avant de lancer."/>
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="ProgDiag" Height="4" Margin="0,12,0,0" Maximum="60" Visibility="Collapsed"/>

                        <StackPanel x:Name="PanelSummary" Orientation="Horizontal" Margin="0,14,0,4" Visibility="Collapsed">
                            <Border Background="{DynamicResource DangerBg}" CornerRadius="4" Padding="9,3" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtErrCount" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource DangerText}"/>
                            </Border>
                            <Border Background="{DynamicResource WarningBg}" CornerRadius="4" Padding="9,3" Margin="0,0,8,0">
                                <TextBlock x:Name="TxtWarnCount" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningText}"/>
                            </Border>
                            <CheckBox x:Name="ChkShowInfo" Style="{StaticResource SelectCheckBox}" VerticalAlignment="Center" Margin="8,0,8,0" Click="ChkShowInfo_Click"/>
                            <TextBlock x:Name="TxtInfoCount" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                        </StackPanel>

                        <ItemsControl x:Name="ListIssues" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="28" Height="28" CornerRadius="14" Background="{Binding Bg}" Margin="0,0,12,0" VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource FontIcon}" FontSize="12" Foreground="{Binding Fg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextMuted}" FontFamily="{StaticResource FontMono}" TextWrapping="Wrap" Margin="0,4,0,0"
                                                           Visibility="{Binding DetailsVisibility}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Pied -->
        <DockPanel Grid.Row="2" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Options d'alimentation" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnPowerOptions_Click"
                        ToolTip="Ouvre Paramètres > Système > Alimentation et batterie"/>
                <Button Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
