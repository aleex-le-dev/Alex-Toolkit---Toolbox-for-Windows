<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.DriverBackupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sauvegarde des pilotes"
        Width="1000" Height="720"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="820" MinHeight="560"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" x:Name="BtnImport" Style="{StaticResource ActionButton}" VerticalAlignment="Center" Click="BtnImport_Click"
                    ToolTip="Installe tous les pilotes d'un dossier de sauvegarde (après une réinstallation de Windows)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE896;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Réinstaller depuis une sauvegarde" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE772;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock Text="Sauvegarde des pilotes" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Pilotes des fabricants installés sur ce PC (carte graphique, Wi-Fi, son, imprimante…). Sauvegardez-les avant de réinstaller Windows, puis réinstallez-les en un clic."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Filtres -->
        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkAll" Style="{StaticResource SelectCheckBox}" VerticalAlignment="Center" Margin="13,0,12,0" ToolTip="Cocher / décocher les pilotes affichés" Click="ChkAll_Click"/>
            <Grid Grid.Column="1">
                <TextBox x:Name="TxtSearch" Style="{StaticResource FieldTextBox}" VerticalContentAlignment="Center" Padding="30,0,8,0" TextChanged="Filter_Changed"/>
                <TextBlock Text="&#xE721;" FontFamily="{StaticResource FontIcon}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
            </Grid>
            <ComboBox Grid.Column="2" x:Name="CmbClass" Style="{StaticResource FieldComboBox}" Width="240" Margin="8,0,0,0" SelectionChanged="Filter_Changed"/>
        </Grid>

        <!-- Liste -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox x:Name="LstDrivers" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Row}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" Style="{StaticResource SelectCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Grid.Column="1" Background="{DynamicResource AccentDim}" CornerRadius="4" Padding="8,2" Margin="0,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceClass}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Devices}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Devices}"/>
                                    <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding Inf}" FontFamily="{StaticResource FontMono}" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="PanelEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar x:Name="ProgLoad" Width="220" Height="3" IsIndeterminate="True" Margin="0,0,0,12"/>
                    <TextBlock x:Name="TxtEmpty" Text="Inventaire des pilotes installés…" Foreground="{DynamicResource TextSecondary}" FontSize="12" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pied -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="ProgExport" Height="4" Margin="0,0,0,10" Visibility="Collapsed" Maximum="1"/>
            <DockPanel Grid.Row="1">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnExport" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" IsEnabled="False" Click="BtnExport_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74E;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtExport" Text="Sauvegarder" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
