<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.ProfileMigrationDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sauvegarde &amp; migration de profil"
        Width="960" Height="880"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="820" MinHeight="600"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE8F7;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Sauvegarde &amp; migration de profil" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtSubtitle" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock DockPanel.Dock="Right" x:Name="TxtTotal" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center"/>
                        <TextBlock Text="Éléments" FontWeight="SemiBold" FontSize="14"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ListItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,4,0"/>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="13"/>
                                                <TextBlock Text="{Binding SourcePath}" Foreground="{DynamicResource TextMuted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding SizeText}" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Intervention client" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Changement de PC ou formatage : console rapide (robocopy 16 threads), profils Firefox / Thunderbird, export guidé des mots de passe Chrome / Edge, clé Windows, imprimantes et rapport d'intervention."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,10"/>
                        <TextBlock Text="Nom du client" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtClient" Style="{StaticResource FieldTextBox}" Margin="0,0,0,8"/>
                        <TextBlock Text="Disque externe" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,0,0,4"/>
                        <ComboBox x:Name="CmbDrive" Style="{StaticResource FieldComboBox}" HorizontalAlignment="Stretch" Margin="0,0,0,10"/>
                        <Button x:Name="BtnClientBackup" Content="Sauvegarder le PC client" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Click="BtnClientBackup_Click"/>
                        <Button x:Name="BtnClientRestore" Content="Restaurer sur ce PC" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="BtnClientRestore_Click"/>
                        <Button x:Name="BtnClientUnlock" Content="Débloquer un ancien disque…" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,8,0,0" Click="BtnClientUnlock_Click"
                                ToolTip="Disque d'un ancien PC branché en USB et « Vous ne disposez pas des autorisations » : reprend la propriété (takeown) et donne le contrôle total (icacls)"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel>
                        <TextBlock Text="Sauvegarder" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Copie les éléments cochés dans un dossier daté sur la destination choisie (disque externe, clé USB, NAS)."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,8"/>
                        <CheckBox x:Name="ChkSkipRegenerable" IsChecked="True" Margin="0,0,0,10" MinWidth="0">
                            <TextBlock TextWrapping="Wrap" FontSize="12">
                                <Run Text="Ignorer les dossiers régénérables"/>
                                <Run Text="(node_modules, __pycache__ : des milliers de petits fichiers, très lents sur clé USB)" Foreground="{DynamicResource TextMuted}"/>
                            </TextBlock>
                        </CheckBox>
                        <Button x:Name="BtnBackup" Content="Choisir la destination et sauvegarder" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Click="BtnBackup_Click"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="Restaurer" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="Sur le nouveau PC : remet les éléments cochés dans le profil actuel. Rien n'est supprimé et un fichier plus récent n'est jamais écrasé."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,12"/>
                        <Button x:Name="BtnRestore" Content="Choisir une sauvegarde et restaurer" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Click="BtnRestore_Click"/>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource WarningBg}" CornerRadius="8" Padding="12" Margin="0,12,0,0">
                    <TextBlock Text="La sauvegarde contient les clés Wi-Fi en clair : conservez-la sur un support que vous contrôlez."
                               Foreground="{DynamicResource WarningText}" FontSize="11.5" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Avancement et journal de la copie (affichés dès le lancement, conservés après) -->
        <Border Grid.Row="2" x:Name="PanelProgress" Visibility="Collapsed" Margin="0,14,0,0"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="TxtProgPct" Text="0 %" FontFamily="{StaticResource FontDisplay}" FontSize="22" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtProgItem" Text="" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                        <TextBlock x:Name="TxtProgDetail" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DockPanel>
                <!-- Barres dessinées (colonnes en étoile : remplie = %, reste = 100 - %) -->
                <Border Height="8" CornerRadius="4" Background="{DynamicResource BgInput}" Margin="0,10,0,0" ClipToBounds="True">
                    <Grid x:Name="BarItem">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Background="{DynamicResource Accent}"/>
                    </Grid>
                </Border>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Right" x:Name="TxtProgOverall" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <Border Height="4" CornerRadius="2" Background="{DynamicResource BgInput}" VerticalAlignment="Center" ClipToBounds="True">
                        <Grid x:Name="BarOverall">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0*"/>
                                <ColumnDefinition Width="100*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="2" Background="{DynamicResource TextMuted}"/>
                        </Grid>
                    </Border>
                </DockPanel>
                <TextBox x:Name="TxtLog" Margin="0,10,0,0" Height="130" IsReadOnly="True" TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="{StaticResource FontMono}" FontSize="11.5"
                         Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextSecondary}" BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="8,6"/>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnCancel" Content="Arrêter" Style="{StaticResource DangerActionButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnCancel_Click"/>
            <TextBlock x:Name="TxtStatus" Text="Calcul des tailles…" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
