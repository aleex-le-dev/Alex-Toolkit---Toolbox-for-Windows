<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.DriverStoreCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Anciennes versions des pilotes"
        Width="1000" Height="700"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="820" MinHeight="540"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="12,9">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgCardHover}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0" VerticalAlignment="Top">
                <TextBlock Text="&#xE772;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Anciennes versions des pilotes" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="À chaque mise à jour d'un pilote (carte graphique, son, puce, Wi-Fi…), Windows garde l'ancienne version. Supprimez-les pour libérer de l'espace : la version la plus récente de chaque pilote est toujours conservée."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Résumé -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,10">
            <DockPanel>
                <CheckBox x:Name="ChkAll" Style="{StaticResource SelectCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0" IsEnabled="False"
                          ToolTip="Cocher / décocher toutes les anciennes versions supprimables" Click="ChkAll_Click"/>
                <TextBlock x:Name="TxtSummary" Text="Analyse du magasin de pilotes…" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap"/>
            </DockPanel>
        </Border>

        <!-- Liste -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <ListBox x:Name="LstDrivers" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource Row}"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" IsEnabled="{Binding CanDelete}" Style="{StaticResource SelectCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <Border Grid.Column="1" Background="{DynamicResource AccentDim}" CornerRadius="4" Padding="8,2" Margin="0,0,12,0" HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DeviceClass}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" TextTrimming="CharacterEllipsis"/>
                                </Border>
                                <StackPanel Grid.Column="2" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding SizeText}" FontWeight="SemiBold" FontSize="12.5" HorizontalAlignment="Right"/>
                                    <Border Background="{DynamicResource WarningBg}" CornerRadius="4" Padding="6,1" Margin="0,3,0,0" HorizontalAlignment="Right"
                                            Visibility="{Binding InUseVisibility}">
                                        <TextBlock Text="En service, conservée" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource WarningText}"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="PanelEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="520">
                    <ProgressBar x:Name="ProgLoad" Width="220" Height="3" IsIndeterminate="True" Margin="0,0,0,12"/>
                    <TextBlock x:Name="TxtEmptyIcon" Text="&#xE73E;" FontFamily="{StaticResource FontIcon}" FontSize="30" Foreground="{DynamicResource SuccessText}"
                               HorizontalAlignment="Center" Margin="0,0,0,10" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtEmpty" Text="Lecture des pilotes installés et de leurs versions…" Foreground="{DynamicResource TextSecondary}" FontSize="12.5"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Pied -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <ProgressBar x:Name="ProgDelete" Height="4" Margin="0,0,0,10" Visibility="Collapsed" Maximum="1"/>
            <DockPanel Grid.Row="1">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnDelete" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" IsEnabled="False" Click="BtnDelete_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtDelete" Text="Supprimer" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
                </StackPanel>
                <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
