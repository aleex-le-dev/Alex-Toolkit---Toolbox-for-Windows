<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.PrinterCenterDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Centre de dépannage des imprimantes"
        Width="1080" Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="900" MinHeight="620"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnAddPrinter_Click" ToolTip="Ouvre « Imprimantes et scanners » de Windows">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Ajouter une imprimante" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnRefresh" Style="{StaticResource ActionButton}" Click="BtnRefresh_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Actualiser" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE749;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Centre de dépannage des imprimantes" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="État réel de chaque imprimante, conseil adapté, file d'attente, pilotes et erreurs récentes." Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Service d'impression -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BtnPnpRescan" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnPnpRescan_Click"
                            ToolTip="Lance une redétection matérielle Plug &amp; Play (USB et réseau) : Windows réinstalle automatiquement les imprimantes connectées">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Réinstallation auto (Plug &amp; Play)" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="Redémarrer le service" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnRestartSpooler_Click"/>
                    <Button x:Name="BtnUnblock" Style="{StaticResource WarningActionButton}" Click="BtnUnblock_Click"
                            ToolTip="Arrête le service, supprime les documents bloqués, relance le service : à utiliser quand plus rien ne s'imprime">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE895;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Débloquer l'impression" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Service d'impression (spouleur)" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                    <Border x:Name="BadgeSpooler" CornerRadius="4" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center" Background="{DynamicResource BgInput}">
                        <TextBlock x:Name="TxtSpooler" Text="…" FontSize="11.5" FontWeight="SemiBold"/>
                    </Border>
                    <TextBlock x:Name="TxtSpoolerStart" Text="" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="340"/>
                </Grid.ColumnDefinitions>

                <!-- Liste des imprimantes -->
                <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="TxtPrintersTitle" Text="Imprimantes" FontWeight="SemiBold" FontSize="14" Margin="4,0,0,8"/>
                        <Grid>
                            <ListBox x:Name="ListPrinters" Background="Transparent" BorderThickness="0" MinHeight="260"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="ListPrinters_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource BgInput}" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource FontIcon}" FontSize="15" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/>
                                                    <Border CornerRadius="4" Padding="6,0,6,1" Margin="8,0,0,0" VerticalAlignment="Center" Background="{DynamicResource AccentDim}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDefault}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="par défaut" FontSize="10.5" Foreground="{DynamicResource AccentText}"/>
                                                    </Border>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Details}" FontSize="11.5" Foreground="{DynamicResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <Border Grid.Column="2" CornerRadius="4" Padding="8,2" VerticalAlignment="Center" Background="{Binding StatusBg}">
                                                <TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="11.5" FontWeight="SemiBold"/>
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TxtNoPrinter" Text="Chargement des imprimantes…" Foreground="{DynamicResource TextSecondary}" FontSize="12"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380"/>
                        </Grid>
                    </DockPanel>
                </Border>

                <!-- Imprimante sélectionnée -->
                <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel x:Name="PanelSelected" IsEnabled="False">
                        <TextBlock x:Name="TxtSelName" Text="Sélectionnez une imprimante" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap"/>
                        <TextBlock x:Name="TxtSelInfo" Text="" Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <Border x:Name="AdviceBox" Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12,10" Margin="0,12,0,14">
                            <StackPanel>
                                <TextBlock x:Name="TxtSelStatus" Text="" FontWeight="SemiBold" FontSize="12.5"/>
                                <TextBlock x:Name="TxtSelAdvice" Text="Choisissez une imprimante dans la liste pour voir son état et les actions possibles." FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Button Content="Imprimer une page de test" Style="{StaticResource PrimaryActionButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8" Click="BtnTestPage_Click"/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnOnline" Content="Remettre en ligne" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch"
                                    ToolTip="Désactive le mode hors connexion et reprend l'impression en pause" Click="BtnOnline_Click"/>
                            <Button Grid.Column="2" x:Name="BtnDefault" Content="Par défaut" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Click="BtnDefault_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button x:Name="BtnClearQueue" Content="Vider la file" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Click="BtnClearQueue_Click"/>
                            <Button Grid.Column="2" Content="Voir la file" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Click="BtnOpenQueue_Click"/>
                        </Grid>
                        <Button Content="Propriétés et préférences" Style="{StaticResource ActionButton}" HorizontalAlignment="Stretch" Margin="0,0,0,14" Click="BtnProperties_Click"/>

                        <TextBlock Text="EN CAS DE PROBLÈME PERSISTANT" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>
                        <Button Content="Réinstaller l'imprimante" Style="{StaticResource WarningActionButton}" HorizontalAlignment="Stretch" Margin="0,0,0,8"
                                ToolTip="Supprime puis recrée l'imprimante avec le même pilote et le même port : corrige une configuration corrompue" Click="BtnReinstall_Click"/>
                        <Button Content="Supprimer l'imprimante" Style="{StaticResource DangerActionButton}" HorizontalAlignment="Stretch" Click="BtnRemove_Click"/>
                    </StackPanel>
                </Border>

                <!-- Pilotes + erreurs -->
                <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" x:Name="BtnRemoveDrivers" Content="Supprimer les inutilisés" Style="{StaticResource ActionButton}" FontSize="12" Padding="10,3" MinHeight="28"
                                        ToolTip="Supprime les pilotes de fabricants qui ne servent à aucune imprimante (cause fréquente de conflits)" Click="BtnRemoveDrivers_Click"/>
                                <TextBlock x:Name="TxtDriversTitle" Text="Pilotes d'impression" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                            </DockPanel>
                            <ItemsControl x:Name="ListDrivers">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding Details}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Button Content="Supprimer" Style="{StaticResource DangerActionButton}" FontSize="10.5" Padding="7,2" MinHeight="22" Margin="0,0,4,0"
                                                            Click="BtnDeleteSingleDriver_Click" Tag="{Binding}" ToolTip="Supprime ce pilote de Windows"/>
                                                    <Button Content="Purger .inf" Style="{StaticResource ActionButton}" FontSize="10.5" Padding="7,2" MinHeight="22"
                                                            Click="BtnPurgeSingleDriver_Click" Tag="{Binding}" ToolTip="Supprime le pilote et purge le package OEM du DriverStore"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Erreurs d'impression (7 derniers jours)" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                            <TextBlock x:Name="TxtNoErrors" Text="Aucune erreur enregistrée par le service d'impression." Foreground="{DynamicResource SuccessText}" FontSize="12" Visibility="Collapsed"/>
                            <ItemsControl x:Name="ListErrors">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="0,6">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left" Text="{Binding Date}" Width="80" FontSize="11.5" Foreground="{DynamicResource TextMuted}"/>
                                                <TextBlock Text="{Binding Message}" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <ProgressBar x:Name="ProgBar" DockPanel.Dock="Right" Width="140" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,14,0"/>
            <TextBlock x:Name="TxtStatus" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
