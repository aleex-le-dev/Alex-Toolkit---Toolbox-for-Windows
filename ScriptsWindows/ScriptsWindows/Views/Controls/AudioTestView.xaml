<UserControl x:Class="ScriptsWindows.Views.Controls.AudioTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgDeep}"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="{StaticResource FontMain}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="24">
            <DockPanel Margin="0,0,0,16">
                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0" VerticalAlignment="Top">
                    <TextBlock Text="&#xE767;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Test du son et du micro" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                    <TextBlock Text="Vérifiez que chaque haut-parleur fonctionne (gauche / droite non inversés) et que le micro capte votre voix."
                               Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>

            <!-- Haut-parleurs -->
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="HAUT-PARLEURS ET CASQUE" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                    <WrapPanel>
                        <Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Click="BtnLeft_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE76B;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bip à gauche" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ActionButton}" Margin="0,0,8,8" Click="BtnRight_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Bip à droite" VerticalAlignment="Center"/>
                                <TextBlock Text="&#xE76C;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" Click="BtnBoth_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE767;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Bip des deux côtés" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="TxtSpeaker" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"
                               Text="Le son sort sur le périphérique audio par défaut de Windows. Pas de son : vérifiez le volume, la sortie choisie (icône du haut-parleur) et le branchement."/>
                </StackPanel>
            </Border>

            <!-- Micro -->
            <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="MICRO" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>

                    <Border x:Name="PanelMicDenied" Background="{DynamicResource WarningBg}" BorderBrush="{DynamicResource Warning}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Ouvrir le réglage" Style="{StaticResource ActionButton}" Margin="10,0,0,0" VerticalAlignment="Center" Click="BtnMicPrivacy_Click"/>
                            <TextBlock Text="Windows bloque l'accès au micro (Paramètres > Confidentialité > Microphone) : le niveau restera à zéro tant que l'accès n'est pas autorisé pour les applications de bureau."
                                       Foreground="{DynamicResource WarningText}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <DockPanel Margin="0,0,0,10">
                        <TextBlock Text="Micro :" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="12.5"/>
                        <ComboBox x:Name="CmbMic" Style="{StaticResource FieldComboBox}" MinWidth="320" HorizontalAlignment="Left" SelectionChanged="CmbMic_SelectionChanged"/>
                    </DockPanel>

                    <TextBlock Text="Parlez : la barre doit bouger." FontSize="12" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                    <ProgressBar x:Name="MicLevel" Height="14" Maximum="1" Margin="0,0,0,12"/>

                    <WrapPanel>
                        <Button x:Name="BtnRecord" Style="{StaticResource ActionButton}" Margin="0,0,8,8" Click="BtnRecord_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7C8;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock x:Name="TxtRecord" Text="Enregistrer 5 secondes" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnPlay" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" IsEnabled="False" Click="BtnPlay_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Écouter l'enregistrement" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="TxtMic" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
