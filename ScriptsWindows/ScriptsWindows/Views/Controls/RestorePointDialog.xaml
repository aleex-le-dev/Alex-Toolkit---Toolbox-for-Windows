<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.RestorePointDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Points de restauration"
        Width="860" Height="720" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="720" MinHeight="560"
        Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE777;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Points de restauration" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Une photo des réglages, pilotes et logiciels de Windows pour revenir en arrière après un problème. Vos documents ne sont pas touchés."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Protection -->
        <Border Grid.Row="1" x:Name="PanelProtection" CornerRadius="8" Padding="16,12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BtnEnable" Content="Activer la protection" Style="{StaticResource PrimaryActionButton}" Visibility="Collapsed" VerticalAlignment="Center" Click="BtnEnable_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtProtection" Text="Lecture de la protection du système…" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock x:Name="TxtSpace" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Création -->
        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="8" Padding="16,12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Créer un point maintenant" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="Avant d'installer un pilote, un logiciel douteux ou de modifier le registre. Fonctionne même si un point a déjà été créé aujourd'hui."
                           Foreground="{DynamicResource TextSecondary}" FontSize="11.5" Margin="0,2,0,8" TextWrapping="Wrap"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="BtnCreatePoint" Content="Créer le point" Style="{StaticResource PrimaryActionButton}" Margin="8,0,0,0" Click="BtnCreatePoint_Click"/>
                    <TextBox x:Name="TxtPointDescription" Style="{StaticResource FieldTextBox}" MaxLength="200" ToolTip="Description du point (par exemple « Avant pilote NVIDIA »)"/>
                </DockPanel>
                <TextBlock x:Name="TxtResult" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Liste -->
        <Border Grid.Row="3" Margin="0,12,0,0" CornerRadius="8" Padding="6" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="10,6,10,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Actualiser" Click="BtnRefresh_Click">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="14"/>
                    </Button>
                    <TextBlock x:Name="TxtCount" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelPoints" Margin="10,0,10,6"/></ScrollViewer>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnOpenRstrui" Content="Restaurer le PC…" Style="{StaticResource WarningActionButton}" Margin="0,0,8,0" Click="BtnOpenRstrui_Click"
                    ToolTip="Ouvre l'assistant Windows pour revenir à un point (redémarrage du PC)"/>
            <TextBlock x:Name="TxtFeedback" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
