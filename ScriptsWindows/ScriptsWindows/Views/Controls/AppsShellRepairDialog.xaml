<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.AppsShellRepairDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réparer le Microsoft Store et les icônes"
        Width="820" Height="720" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="700" MinHeight="560"
        Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE719;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Réparer le Microsoft Store et les icônes" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Store qui ne s'ouvre pas, téléchargements bloqués, icônes blanches ou miniatures fausses."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Store -->
        <Border Grid.Row="1" CornerRadius="8" Padding="16,12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <StackPanel>
                <DockPanel>
                    <Button DockPanel.Dock="Right" x:Name="BtnRepairStore" Content="Réparer le Store" Style="{StaticResource PrimaryActionButton}" VerticalAlignment="Top" Click="BtnRepairStore_Click"
                            ToolTip="Réinitialisation officielle, vidage du cache (wsreset) et réenregistrement du Store et de ses composants"/>
                    <StackPanel>
                        <TextBlock Text="Microsoft Store" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Réinitialise le Store comme Paramètres > Applications > Réinitialiser, vide son cache, puis réenregistre le Store et ses composants pour tous les comptes. Les autres applications ne sont pas touchées."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,12,8"/>
                    </StackPanel>
                </DockPanel>
                <StackPanel x:Name="PanelStore"/>
            </StackPanel>
        </Border>

        <!-- Icônes -->
        <Border Grid.Row="2" Margin="0,12,0,0" CornerRadius="8" Padding="16,12" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="Icônes et miniatures" FontWeight="SemiBold" FontSize="13"/>
                <TextBlock Text="Commencez par le rafraîchissement (sans rien fermer). Si les icônes restent blanches, la reconstruction complète redémarre l'Explorateur : les fenêtres de dossiers se ferment, le Bureau disparaît quelques secondes."
                           Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <WrapPanel>
                    <Button x:Name="BtnRefreshIcons" Content="Rafraîchir les icônes" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnRefreshIcons_Click"/>
                    <Button x:Name="BtnRepairIcons" Content="Reconstruction complète" Style="{StaticResource WarningActionButton}" Click="BtnRepairIcons_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <TextBox Grid.Row="3" x:Name="TxtLog" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource FontMono}" FontSize="11.5" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextSecondary}"
                 BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="8,6"/>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
