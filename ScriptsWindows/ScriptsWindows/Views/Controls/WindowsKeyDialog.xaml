<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.WindowsKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Licence Windows"
        Width="760" Height="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="640" MinHeight="560"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Window.Resources>
        <Style x:Key="KeyText" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMono}"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE8D7;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Licence Windows" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Clé d'activation d'origine (gravée dans la carte mère), clé installée et état de l'activation : à noter avant une réinstallation."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- État d'activation -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18,14" Margin="0,0,0,14">
            <DockPanel>
                <Border x:Name="StatusBadge" Width="44" Height="44" CornerRadius="22" Background="{DynamicResource BgInput}" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusGlyph" Text="&#xE895;" FontFamily="{StaticResource FontIcon}" FontSize="20" Foreground="{DynamicResource TextSecondary}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtActivation" Text="Lecture de la licence…" FontSize="16" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtEdition" Text="" Foreground="{DynamicResource TextSecondary}" FontSize="12.5" Margin="0,3,0,0"/>
                    <TextBlock x:Name="TxtChannel" Text="" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Clés -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="CLÉS DE PRODUIT" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="2,0,0,8"/>

                <!-- Clé BIOS / UEFI -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18,12" Margin="0,0,0,8">
                    <DockPanel>
                        <Button x:Name="BtnCopyOem" DockPanel.Dock="Right" Content="&#xE8C8;" Style="{StaticResource IconButton}" ToolTip="Copier la clé" VerticalAlignment="Center" Tag="Oem" Click="BtnCopy_Click"/>
                        <StackPanel>
                            <TextBlock Text="Clé d'origine (BIOS / UEFI)" FontWeight="SemiBold" FontSize="12.5"/>
                            <TextBlock Text="Gravée par le fabricant dans la carte mère : Windows la réutilise automatiquement après une réinstallation de la même édition."
                                       Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <TextBox x:Name="TxtOemKey" Style="{StaticResource KeyText}" Text="…"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Clé installée -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18,12" Margin="0,0,0,8">
                    <DockPanel>
                        <Button x:Name="BtnCopyInstalled" DockPanel.Dock="Right" Content="&#xE8C8;" Style="{StaticResource IconButton}" ToolTip="Copier la clé" VerticalAlignment="Center" Tag="Installed" Click="BtnCopy_Click"/>
                        <StackPanel>
                            <TextBlock Text="Clé installée" FontWeight="SemiBold" FontSize="12.5"/>
                            <TextBlock x:Name="TxtInstalledHint" Text="Clé actuellement utilisée par Windows (décodée depuis le registre)."
                                       Foreground="{DynamicResource TextMuted}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,6"/>
                            <TextBox x:Name="TxtInstalledKey" Style="{StaticResource KeyText}" Text="…"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Clé de secours -->
                <Border x:Name="CardBackup" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18,12" Margin="0,0,0,8" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="&#xE8C8;" Style="{StaticResource IconButton}" ToolTip="Copier la clé" VerticalAlignment="Center" Tag="Backup" Click="BtnCopy_Click"/>
                        <StackPanel>
                            <TextBlock Text="Clé de secours (registre)" FontWeight="SemiBold" FontSize="12.5"/>
                            <TextBlock Text="Copie conservée par le service de licence de Windows." Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,2,0,6"/>
                            <TextBox x:Name="TxtBackupKey" Style="{StaticResource KeyText}"/>
                        </StackPanel>
                    </DockPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Pied -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Paramètres d'activation" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnActivation_Click"
                        ToolTip="Ouvre Paramètres > Système > Activation (changer de clé, dépanner l'activation)"/>
                <Button x:Name="BtnExport" Style="{StaticResource ActionButton}" Margin="0,0,8,0" IsEnabled="False" Click="BtnExport_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE74E;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Exporter" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
