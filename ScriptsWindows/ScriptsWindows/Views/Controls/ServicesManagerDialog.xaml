<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.ServicesManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Services Windows"
        Width="1000" Height="820" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="820" MinHeight="600"
        Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE912;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Services Windows" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Tous les services, leur éditeur et leur état. Repérez ceux qui devraient tourner et sont arrêtés, redémarrez-les ou changez leur démarrage. Les services vitaux de Windows sont protégés."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <ComboBox DockPanel.Dock="Right" x:Name="CmbFilter" Style="{StaticResource FieldComboBox}" Width="250" Margin="10,0,0,0" SelectedIndex="0" SelectionChanged="Filter_Changed">
                <ComboBoxItem Content="À vérifier (automatiques arrêtés)"/>
                <ComboBoxItem Content="Hors Microsoft (logiciels installés)"/>
                <ComboBoxItem Content="En cours d'exécution"/>
                <ComboBoxItem Content="Désactivés"/>
                <ComboBoxItem Content="Tous les services"/>
            </ComboBox>
            <TextBox x:Name="TxtSearch" Style="{StaticResource FieldTextBox}" TextChanged="Filter_Changed" ToolTip="Rechercher un service (nom, description, éditeur)"/>
        </DockPanel>

        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6">
            <Grid>
                <ScrollViewer x:Name="ScrollList" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelList" Margin="6,2"/></ScrollViewer>
                <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" Foreground="{DynamicResource TextMuted}" FontSize="12.5" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="24"/>
            </Grid>
        </Border>

        <!-- Détail du service choisi -->
        <Border Grid.Row="3" x:Name="PanelDetail" Visibility="Collapsed" Margin="0,12,0,0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="TxtDetailName" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtDetailInfo" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,2,0,4" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtDetailDesc" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" MaxHeight="54"/>
                <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="BtnStart" Content="Démarrer" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,6" Click="BtnStart_Click"/>
                    <Button x:Name="BtnRestart" Content="Redémarrer" Style="{StaticResource ActionButton}" Margin="0,0,8,6" Click="BtnRestart_Click"/>
                    <Button x:Name="BtnStop" Content="Arrêter" Style="{StaticResource ActionButton}" Margin="0,0,20,6" Click="BtnStop_Click"/>
                    <TextBlock Text="Démarrage :" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,6"/>
                    <ComboBox x:Name="CmbStart" Style="{StaticResource FieldComboBox}" Width="220" Margin="0,0,8,6">
                        <ComboBoxItem Content="Automatique" Tag="auto"/>
                        <ComboBoxItem Content="Automatique (différé)" Tag="delayed"/>
                        <ComboBoxItem Content="Manuel" Tag="manual"/>
                        <ComboBoxItem Content="Désactivé" Tag="disabled"/>
                    </ComboBox>
                    <Button x:Name="BtnApplyStart" Content="Appliquer" Style="{StaticResource ActionButton}" Margin="0,0,0,6" Click="BtnApplyStart_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" Content="services.msc" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnOpenServicesMsc_Click"/>
            <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="Actualiser" Margin="0,0,8,0" Click="BtnRefresh_Click">
                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="14"/>
            </Button>
            <TextBlock x:Name="TxtFeedback" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
