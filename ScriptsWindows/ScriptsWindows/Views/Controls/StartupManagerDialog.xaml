<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.StartupManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programmes au démarrage"
        Width="980" Height="760"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="800" MinHeight="560"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE7E8;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Programmes au démarrage" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Désactivez ce qui n'a pas besoin de se lancer avec Windows. Rien n'est supprimé : tout se réactive ici ou dans le Gestionnaire des tâches, et prend effet au prochain démarrage."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Avertissement : application lancée sous un autre compte que la session ouverte -->
        <Border Grid.Row="1" x:Name="PanelAccount" Visibility="Collapsed" Background="{DynamicResource WarningBg}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <TextBlock x:Name="TxtAccount" Foreground="{DynamicResource WarningText}" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Résumé + filtre -->
        <DockPanel Grid.Row="2" Margin="0,0,0,10">
            <ComboBox DockPanel.Dock="Right" x:Name="CmbFilter" Style="{StaticResource FieldComboBox}" Width="230" SelectedIndex="0" SelectionChanged="CmbFilter_SelectionChanged">
                <ComboBoxItem Content="Tous les programmes"/>
                <ComboBoxItem Content="Activés au démarrage"/>
                <ComboBoxItem Content="Désactivés"/>
                <ComboBoxItem Content="Fichier introuvable (à vérifier)"/>
            </ComboBox>
            <TextBlock x:Name="TxtSummary" Text="Analyse des programmes au démarrage…" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- Liste -->
        <Border Grid.Row="3" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6">
            <Grid>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="PanelList" Margin="6"/>
                </ScrollViewer>
                <TextBlock x:Name="TxtEmpty" Visibility="Collapsed" Foreground="{DynamicResource TextMuted}" FontSize="12.5" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" Margin="24"/>
            </Grid>
        </Border>

        <!-- Pied -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="Actualiser" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
            <Button DockPanel.Dock="Right" Content="Dossier Démarrage" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnOpenStartupFolder_Click"/>
            <Button DockPanel.Dock="Right" Content="Gestionnaire des tâches" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnOpenTaskmgr_Click"/>
            <TextBlock x:Name="TxtFeedback" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
