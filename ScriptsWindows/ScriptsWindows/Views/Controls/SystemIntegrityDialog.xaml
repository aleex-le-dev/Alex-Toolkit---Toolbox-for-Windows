<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.SystemIntegrityDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Réparer les fichiers système"
        Width="900" Height="800" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="760" MinHeight="600"
        Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Réparer les fichiers système" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="DISM répare l'image de Windows (source des fichiers), puis SFC remplace les fichiers système endommagés. Le résultat de chaque étape est vérifié."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- État + actions -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="TxtImageState" Text="Lecture de l'état de l'image Windows…" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtPending" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,2,0,10" TextWrapping="Wrap"/>
                <WrapPanel>
                    <Button x:Name="BtnRunPipeline" Content="Réparation complète (recommandé)" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,8" Click="BtnRunPipeline_Click"
                            ToolTip="DISM /RestoreHealth puis SFC /scannow : 15 à 40 minutes"/>
                    <Button x:Name="BtnRunScanHealth" Content="Analyser l'image (DISM)" Style="{StaticResource ActionButton}" Margin="0,0,8,8" Click="BtnRunScanHealth_Click"
                            ToolTip="DISM /ScanHealth : vérifie l'image sans la modifier (5 à 15 minutes)"/>
                    <Button x:Name="BtnRunRestoreHealth" Content="Réparer l'image (DISM)" Style="{StaticResource ActionButton}" Margin="0,0,8,8" Click="BtnRunRestoreHealth_Click"
                            ToolTip="DISM /RestoreHealth : télécharge les fichiers sains depuis Windows Update"/>
                    <Button x:Name="BtnRunSfc" Content="Vérifier les fichiers (SFC)" Style="{StaticResource ActionButton}" Margin="0,0,8,8" Click="BtnRunSfc_Click"
                            ToolTip="SFC /scannow : remplace les fichiers système endommagés (5 à 15 minutes)"/>
                </WrapPanel>
                <DockPanel Margin="0,4,0,0">
                    <TextBlock Text="Windows Update :" Foreground="{DynamicResource TextMuted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="BtnWuStatus" Content="État et derniers échecs" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnWuStatus_Click"/>
                    <Button x:Name="BtnWuReset" Content="Réinitialiser" Style="{StaticResource WarningActionButton}" HorizontalAlignment="Left" Click="BtnWuReset_Click"
                            ToolTip="Arrête les services, recrée les caches SoftwareDistribution et catroot2 (mises à jour installées non touchées)"/>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Avancement -->
        <Border Grid.Row="2" x:Name="PanelProgress" Visibility="Collapsed" Margin="0,12,0,0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="TxtPct" FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStep" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock x:Name="TxtElapsed" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
                <Border Height="8" CornerRadius="4" Background="{DynamicResource BgInput}" Margin="0,10,0,0" ClipToBounds="True">
                    <Grid x:Name="BarProgress"><Grid.ColumnDefinitions><ColumnDefinition Width="0*"/><ColumnDefinition Width="100*"/></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Background="{DynamicResource Accent}"/></Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Verdict -->
        <Border Grid.Row="3" x:Name="PanelVerdict" Visibility="Collapsed" Margin="0,12,0,0" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="TxtVerdict" FontFamily="{StaticResource FontDisplay}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock x:Name="TxtVerdictDetail" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>

        <!-- Journal de la fenêtre -->
        <TextBox Grid.Row="4" x:Name="TxtLog" Margin="0,12,0,0" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 FontFamily="{StaticResource FontMono}" FontSize="11.5" Background="{DynamicResource BgInput}" Foreground="{DynamicResource TextSecondary}"
                 BorderBrush="{DynamicResource Border}" BorderThickness="1" Padding="8,6"/>

        <DockPanel Grid.Row="5" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnCancel" Content="Arrêter" Style="{StaticResource DangerActionButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnCancel_Click"/>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
