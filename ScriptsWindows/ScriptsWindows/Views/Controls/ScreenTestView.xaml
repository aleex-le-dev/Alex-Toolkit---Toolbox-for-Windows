<UserControl x:Class="ScriptsWindows.Views.Controls.ScreenTestView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgDeep}"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="{StaticResource FontMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0" VerticalAlignment="Top">
                <TextBlock Text="&#xE7F4;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Test de l'écran" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Affiche des couleurs en plein écran pour repérer les pixels morts (toujours noirs) ou bloqués (toujours colorés), les fuites de lumière et les défauts d'affichage."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ÉCRANS DÉTECTÉS" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,10"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="340">
                    <StackPanel x:Name="PanelDisplays"/>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="PENDANT LE TEST" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextSecondary}" FontSize="12" LineHeight="19"
                           Text="Clic gauche, Espace ou flèche droite : couleur suivante · Clic droit ou flèche gauche : précédente · Échap : quitter. 9 mires : noir, blanc, rouge, vert, bleu, gris, dégradé, dégradé de couleurs et damier fin (netteté). Regardez l'écran de face, à environ 50 cm, et nettoyez-le avant : une poussière ressemble à un pixel mort."/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
