<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.DriveSpeedDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vitesse des clés USB et disques"
        Width="1040" Height="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="880" MinHeight="620"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE88E;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Vitesse des clés USB et disques" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Mesure réelle, sans le cache de Windows. Chaque support testé est gardé en mémoire pour comparer vos clés et disques entre eux."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Choix du support -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <TextBlock Text="Support à tester" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,0,0,4"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Style="{StaticResource IconButton}" ToolTip="Actualiser (après avoir branché une clé)" Margin="6,0,0,0" Click="BtnRefresh_Click">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="14"/>
                        </Button>
                        <ComboBox x:Name="CmbDrive" Style="{StaticResource FieldComboBox}" HorizontalAlignment="Stretch" DisplayMemberPath="Display"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="Taille du test" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbSize" Style="{StaticResource FieldComboBox}" Width="210" SelectedIndex="0">
                        <ComboBoxItem Content="256 Mo  (rapide)" Tag="256"/>
                        <ComboBoxItem Content="1 Go  (plus précis)" Tag="1024"/>
                    </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button x:Name="BtnCancel" Content="Arrêter" Style="{StaticResource DangerActionButton}" Visibility="Collapsed" Margin="0,0,8,0" Click="BtnCancel_Click"/>
                    <Button x:Name="BtnRun" Style="{StaticResource PrimaryActionButton}" Click="BtnRun_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="{StaticResource FontIcon}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Text="Lancer le test" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Avancement -->
        <Border Grid.Row="2" x:Name="PanelProgress" Visibility="Collapsed" Margin="0,12,0,0"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="TxtLive" FontFamily="{StaticResource FontDisplay}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStep" Text="Préparation…" FontWeight="SemiBold" FontSize="13"/>
                        <TextBlock Text="Le test écrit un fichier temporaire sur le support puis le supprime. Ne débranchez pas le support pendant le test."
                                   Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,2,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
                <Border Height="8" CornerRadius="4" Background="{DynamicResource BgInput}" Margin="0,10,0,0" ClipToBounds="True">
                    <Grid x:Name="BarProgress">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Background="{DynamicResource Accent}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="3" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Dernier résultat -->
                <Border x:Name="PanelResult" Visibility="Collapsed" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="300"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock x:Name="TxtResultName" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock x:Name="TxtResultInfo" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,2,0,12"/>
                            <StackPanel x:Name="PanelMetrics"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="VERDICT" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock x:Name="TxtVerdict" FontFamily="{StaticResource FontDisplay}" FontSize="24" FontWeight="SemiBold" Margin="0,2,0,2"/>
                            <TextBlock x:Name="TxtVerdictDetail" Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap"/>
                            <Border Background="{DynamicResource BgInput}" CornerRadius="6" Padding="12,10" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="Temps de copie estimé vers ce support" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,6"/>
                                    <StackPanel x:Name="PanelEstimates"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Comparatif -->
                <Border Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="18">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right" x:Name="TxtCompareCount" Foreground="{DynamicResource TextMuted}" FontSize="11.5" VerticalAlignment="Center"/>
                            <TextBlock Text="Comparer mes clés et disques" FontWeight="SemiBold" FontSize="14"/>
                        </DockPanel>
                        <TextBlock Text="Dernier test de chaque support, du plus rapide au plus lent en écriture. Les barres sont relatives au meilleur de chaque colonne. Renommez un support pour le reconnaître (« Clé rouge », « Disque Paul »…)."
                                   Foreground="{DynamicResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,12"/>
                        <TextBlock x:Name="TxtNoHistory" Text="Aucun support testé pour l'instant : choisissez une clé ou un disque puis lancez le test."
                                   Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
                        <StackPanel x:Name="PanelCompare"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <TextBlock x:Name="TxtStatus" Text="Recherche des clés et disques…" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
