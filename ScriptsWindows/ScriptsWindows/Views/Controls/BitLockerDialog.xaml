<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.BitLockerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BitLocker"
        Width="860" Height="640" WindowStartupLocation="CenterOwner" ResizeMode="CanResize" MinWidth="720" MinHeight="520"
        Background="{DynamicResource BgDeep}" Foreground="{DynamicResource TextPrimary}" FontFamily="{StaticResource FontMain}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE72E;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Chiffrement des disques (BitLocker)" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="État réel de chaque disque, clé de récupération, suspension avant une mise à jour du BIOS, déverrouillage d'un disque client."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" x:Name="PanelInfo" Visibility="Collapsed" Background="{DynamicResource WarningBg}" CornerRadius="8" Padding="14,10" Margin="0,0,0,12">
            <TextBlock x:Name="TxtInfo" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource WarningText}"/>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="PanelVolumes" Margin="8,4"/></ScrollViewer>
        </Border>

        <Border Grid.Row="3" x:Name="PanelAction" Visibility="Collapsed" Margin="0,12,0,0" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" VerticalAlignment="Top" Content="&#xE711;" FontFamily="{StaticResource FontIcon}" Style="{StaticResource ActionButton}" ToolTip="Fermer ce panneau" Click="BtnCloseAction_Click"/>
                <StackPanel x:Name="ActionContent" Margin="0,0,12,0"/>
            </DockPanel>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" Content="Outil Windows" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnPanel_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnRefresh" Content="Actualiser" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnRefresh_Click"/>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</Window>
