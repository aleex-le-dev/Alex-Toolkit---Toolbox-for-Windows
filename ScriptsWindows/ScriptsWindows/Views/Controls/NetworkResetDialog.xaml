<UserControl xmlns:ui="http://schemas.modernwpf.com/2019"
             x:Class="ScriptsWindows.Views.Controls.NetworkResetDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgDeep}"
             Foreground="{DynamicResource TextPrimary}"
             FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,14">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE90F;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Réparer la connexion Internet" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Remet à zéro les réglages réseau de Windows étape par étape, puis vérifie que la connexion fonctionne."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Avertissement -->
        <Border Grid.Row="1" x:Name="InfoBox" Background="{DynamicResource WarningBg}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
            <DockPanel>
                <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource FontIcon}" FontSize="14" Foreground="{DynamicResource WarningText}" Margin="0,1,10,0" VerticalAlignment="Top"/>
                <TextBlock x:Name="TxtInfo" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                           Text="La connexion sera coupée quelques secondes pendant la réparation. Un redémarrage est ensuite nécessaire pour terminer la réinitialisation de Winsock et TCP/IP. Les réseaux Wi-Fi enregistrés et leurs mots de passe sont conservés."/>
            </DockPanel>
        </Border>

        <!-- Étapes -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8">
            <ItemsControl x:Name="ListSteps">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" Padding="16,11">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="30" Height="30" CornerRadius="15" Background="{Binding StateBg}" Margin="0,0,14,0" VerticalAlignment="Top">
                                    <Grid>
                                        <TextBlock Text="{Binding StateGlyph}" FontFamily="{StaticResource FontIcon}" FontSize="13" Foreground="{Binding StateFg}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding GlyphVisibility}"/>
                                        <TextBlock Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{Binding StateFg}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding NumberVisibility}"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/>
                                    <TextBlock Text="{Binding Explanation}" Foreground="{DynamicResource TextSecondary}" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Result}" Foreground="{Binding StateFg}" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,0" Visibility="{Binding ResultVisibility}"/>
                                    <ProgressBar Height="2" IsIndeterminate="True" Margin="0,6,0,0" Visibility="{Binding RunningVisibility}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Pied -->
        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BtnReboot" Style="{StaticResource WarningActionButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnReboot_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE777;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Redémarrer maintenant" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnStart" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" Click="BtnStart_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource FontIcon}" FontSize="12" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TxtStart" Text="Lancer la réparation" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            </StackPanel>
            <TextBlock x:Name="TxtStatus" Text="7 étapes, environ 30 secondes." Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>
