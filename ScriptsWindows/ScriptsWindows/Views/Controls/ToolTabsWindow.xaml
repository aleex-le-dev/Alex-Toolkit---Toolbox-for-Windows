<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.ToolTabsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Outils"
        Width="900" Height="740" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="8,6,8,8">
        <TabControl x:Name="Tabs"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0" />
    </Grid>
</Window>
