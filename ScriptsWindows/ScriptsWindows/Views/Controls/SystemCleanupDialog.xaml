<Window xmlns:ui="http://schemas.modernwpf.com/2019" ui:WindowHelper.UseModernWindowStyle="True"
        x:Class="ScriptsWindows.Views.Controls.SystemCleanupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Grand nettoyage du PC"
        Width="960" Height="860"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize" MinWidth="820" MinHeight="620"
        Background="{DynamicResource BgDeep}"
        Foreground="{DynamicResource TextPrimary}"
        FontFamily="{StaticResource FontMain}">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- En-tête -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource AccentDim}" Margin="0,0,14,0">
                <TextBlock Text="&#xE74D;" FontFamily="{StaticResource FontIcon}" FontSize="18" Foreground="{DynamicResource AccentText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Grand nettoyage du PC" FontFamily="{StaticResource FontDisplay}" FontSize="19" FontWeight="SemiBold"/>
                <TextBlock Text="Libère l'espace occupé par les fichiers inutiles. Les éléments recommandés sont sans risque ; les avancés ont une contrepartie expliquée."
                           Foreground="{DynamicResource TextSecondary}" FontSize="12" Margin="0,2,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>

        <!-- Total + sélection rapide -->
        <DockPanel Grid.Row="1" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnRecommended" Content="Recommandés" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Click="BtnRecommended_Click" ToolTip="Coche seulement les éléments sans risque"/>
                <Button x:Name="BtnAll" Content="Tout cocher" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Click="BtnAll_Click"/>
                <Button x:Name="BtnNone" Content="Tout décocher" Style="{StaticResource ActionButton}" Margin="0,0,6,0" Click="BtnNone_Click"/>
                <Button x:Name="BtnAnalyze" Style="{StaticResource IconButton}" ToolTip="Analyser à nouveau" Click="BtnAnalyze_Click">
                    <TextBlock Text="&#xE72C;" FontFamily="{StaticResource FontIcon}" FontSize="14"/>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="TxtTotal" Text="Analyse de l'espace récupérable…" FontFamily="{StaticResource FontDisplay}" FontSize="17" FontWeight="SemiBold"/>
                <TextBlock x:Name="TxtTotalDetail" Foreground="{DynamicResource TextMuted}" FontSize="11.5" Margin="0,2,0,0"/>
            </StackPanel>
        </DockPanel>

        <!-- Liste -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="8" Padding="6">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="PanelItems" Margin="8,4"/>
            </ScrollViewer>
        </Border>

        <!-- Avancement -->
        <Border Grid.Row="3" x:Name="PanelProgress" Visibility="Collapsed" Margin="0,12,0,0"
                Background="{DynamicResource BgCard}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" x:Name="TxtFreed" FontFamily="{StaticResource FontDisplay}" FontSize="18" FontWeight="SemiBold"
                               Foreground="{DynamicResource SuccessText}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TxtStep" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
                <Border Height="8" CornerRadius="4" Background="{DynamicResource BgInput}" Margin="0,10,0,0" ClipToBounds="True">
                    <Grid x:Name="BarProgress">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="100*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" CornerRadius="4" Background="{DynamicResource Accent}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Pied -->
        <DockPanel Grid.Row="4" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" x:Name="BtnClose" Content="Fermer" Style="{StaticResource ActionButton}" Click="BtnClose_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnCancel" Content="Arrêter" Style="{StaticResource DangerActionButton}" Margin="0,0,8,0" Visibility="Collapsed" Click="BtnCancel_Click"/>
            <Button DockPanel.Dock="Right" x:Name="BtnClean" Style="{StaticResource PrimaryActionButton}" Margin="0,0,8,0" Click="BtnClean_Click">
                <TextBlock x:Name="TxtCleanLabel" Text="Nettoyer la sélection"/>
            </Button>
            <Button DockPanel.Dock="Right" Content="Paramètres de stockage" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnStorageSense_Click"
                    ToolTip="Assistant de stockage de Windows (nettoyage automatique)"/>
            <Button DockPanel.Dock="Right" Content="Nettoyage de disque Windows" Style="{StaticResource ActionButton}" Margin="0,0,8,0" Click="BtnCleanmgr_Click"
                    ToolTip="Outil natif cleanmgr"/>
            <TextBlock x:Name="TxtStatus" Foreground="{DynamicResource TextSecondary}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/>
        </DockPanel>
    </Grid>
</Window>
